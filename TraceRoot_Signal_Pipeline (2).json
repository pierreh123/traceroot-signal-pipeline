      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const enrichment = $input.item.json;\nconst upstream = $('Keep Qualified Only').item.json;\n\nreturn {\n  json: {\n    ...upstream,\n    enrichment_summary: `${enrichment.role_confirmed || 'role unconfirmed'}. ${enrichment.recent_post_or_activity || ''} ${enrichment.company_context || ''}`.trim(),\n    enrichment_confidence: enrichment.confidence || 'low'\n  }\n};"
