    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\n\nlet raw = item.text \n  || item.content?.[0]?.text \n  || item.message?.content?.[0]?.text \n  || item.output;\n\nif (!raw) {\n  throw new Error('Champ texte introuvable. Structure reçue: ' + JSON.stringify(item));\n}\n\nconst firstBrace = raw.indexOf('{');\nconst lastBrace = raw.lastIndexOf('}');\n\nif (firstBrace === -1 || lastBrace === -1 || lastBrace < firstBrace) {\n  throw new Error('Aucun objet JSON trouvé dans la réponse. Contenu brut: ' + raw);\n}\n\nconst cleaned = raw.slice(firstBrace, lastBrace + 1);\nconst parsed = JSON.parse(cleaned);\n\nconst original = $('Split out results').item.json;\n\nreturn { json: { ...parsed, source_url: original.url, source_title: original.title, source_date: original.date } };"
      },
