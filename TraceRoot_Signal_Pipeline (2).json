      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const draft = $input.item.json;\nconst upstream = $('Merge Enrichment').item.json;\n\nlet draftText = draft.text || draft.content?.[0]?.text || draft.message?.content?.[0]?.text || draft.output || '';\n\nreturn {\n  json: {\n    ...upstream,\n    draft_message: draftText.trim()\n  }\n};"
      },
